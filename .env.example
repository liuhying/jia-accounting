# ============================================
# 家记账 (Jia Accounting) - 环境配置
# 复制为 .env 并修改
# ============================================

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=jia_app

# JWT 密钥 (生产环境请修改为随机字符串)
JWT_SECRET=change_me_to_random_string

# 服务端口
PORT=3000
